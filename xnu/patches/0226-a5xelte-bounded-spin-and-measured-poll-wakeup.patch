@@ -1,11 +1,31 @@
-/* Preserve the existing nominal delay budget; yield after a short spin. */
+/* Bound busy polling for short GPU work, then yield for long jobs.
+ * Timeout values are unchanged; measured pauses charge actual wakeup time.
+ * Measured wall time includes scheduler wakeup; it is not a GPU active-cycle measurement. */
 #ifndef A5XELTE_GPU_POLL_H
 #define A5XELTE_GPU_POLL_H
-static inline void a5g3d_poll_pause(unsigned *elapsedUS,unsigned budgetUS)
+struct A5G3DPollStats {
+    uint64_t spinNS = 0, sleepNS = 0;
+    unsigned spins = 0, sleeps = 0;
+};
+static inline void a5g3d_poll_pause(unsigned *elapsedUS,unsigned budgetUS,
+    A5G3DPollStats *stats = nullptr,unsigned spinLimitUS = 2000)
 {
     if(*elapsedUS>=budgetUS)return;
     unsigned remaining=budgetUS-*elapsedUS;
-    if(*elapsedUS>=200 && remaining>=1000){IOSleep(1);*elapsedUS+=1000;}
-    else {unsigned step=remaining<10?remaining:10;IODelay(step);*elapsedUS+=step;}
+    const bool sleep=*elapsedUS>=spinLimitUS && remaining>=1000;
+    const uint64_t begin=stats?mach_absolute_time():0;
+    const unsigned requested=sleep?1000:(remaining<10?remaining:10);
+    if(sleep)IOSleep(1);else IODelay(requested);
+    unsigned charged=requested;
+    if(stats){
+        uint64_t ns=0;absolutetime_to_nanoseconds(mach_absolute_time()-begin,&ns);
+        if(sleep){stats->sleepNS+=ns;++stats->sleeps;}
+        else {stats->spinNS+=ns;++stats->spins;}
+        /* A delayed scheduler wake must not inflate a nominal2s timeout
+         * into many seconds. Clamp before narrowing the measured duration. */
+        const uint64_t actualUS=ns/1000+(ns%1000!=0);
+        if(actualUS>charged)charged=actualUS>=remaining?remaining:(unsigned)actualUS;
+    }
+    *elapsedUS+=charged;
 }
 #endif
